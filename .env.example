# Environment Variables

# Picovoice Porcupine API Key (for wake word detection)
# Get your free key at: https://console.picovoice.ai/
PORCUPINE_ACCESS_KEY=

# Optional: Custom Ollama URL
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: Change Whisper model size (tiny, base, small, medium, large)
# WHISPER_MODEL_SIZE=base

# ============================================================
# Text-to-Speech (Young Boy Assistant Voice)
# ============================================================

# Provider: edge (Microsoft Edge Neural voices)
TTS_PROVIDER=edge

# Primary voice
TTS_VOICE=en-US-BrianNeural

# Voice speed and pitch
TTS_RATE=+20%
TTS_PITCH=+35%
TTS_VOLUME=+0%

# TTS_STYLE=young_boy_5_10 creates a fictional youthful assistant voice.
# This does not clone or imitate any real child.
# TTS_PITCH makes the voice sound younger.
# TTS_RATE makes the voice more energetic.
# If the voice sounds too sharp, reduce pitch to +20%.
# If the voice sounds too fast, reduce rate to +10%.
TTS_STYLE=young_boy_5_10

# Assistant personality used for AI responses.
ASSISTANT_PERSONA=young_boy_safe_assistant

# Optional fallback voices
TTS_FALLBACK_VOICE_1=en-US-AndrewNeural
TTS_FALLBACK_VOICE_2=bn-BD-PradeepNeural

# Recommended settings:
# For very young sound:
#   TTS_RATE=+20%
#   TTS_PITCH=+35%
# For softer childlike sound:
#   TTS_RATE=+12%
#   TTS_PITCH=+25%
# For more natural young assistant:
#   TTS_RATE=+8%
#   TTS_PITCH=+18%
