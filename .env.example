# Environment Variables

# Picovoice Porcupine API Key (for wake word detection)
# Get your free key at: https://console.picovoice.ai/
PORCUPINE_ACCESS_KEY=

# Optional: Custom Ollama URL
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: Change Whisper model size (tiny, base, small, medium, large)
# WHISPER_MODEL_SIZE=base

# Optional: Change TTS voice
# TTS_VOICE=bn-BD-NabanitaNeural
